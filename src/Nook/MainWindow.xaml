<Window x:Class="Nook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook" Width="390" Height="88" MinWidth="390"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#F6F3FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#B8B5C9"/>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="#353044"/>
            <Setter Property="Foreground" Value="#F6F3FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Storyboard x:Key="Breathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CharacterScale" Storyboard.TargetProperty="ScaleX"
                             To="1.035" Duration="0:0:1.8"/>
            <DoubleAnimation Storyboard.TargetName="CharacterScale" Storyboard.TargetProperty="ScaleY"
                             To="0.97" Duration="0:0:1.8"/>
        </Storyboard>
    </Window.Resources>
    <Border CornerRadius="30" Background="#F4232030" BorderBrush="#776B6484"
            BorderThickness="1" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid Height="86">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="74" Height="66" Cursor="Hand"
                      MouseLeftButtonUp="Character_Click" ToolTip="Погладь Nook!">
                    <Ellipse Fill="#B8A7FF" Stroke="#E4D9FF" StrokeThickness="2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="CharacterScale" CenterX="0.5" CenterY="0.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="#66F5EAFF" Width="43" Height="16" Margin="-8,3,0,0"
                             VerticalAlignment="Top" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="LeftEye" Width="6" Height="10" Fill="#302440" Margin="0,0,13,0"/>
                        <Ellipse x:Name="RightEye" Width="6" Height="10" Fill="#302440"/>
                    </StackPanel>
                    <TextBlock x:Name="Mouth" Text="ᴗ" Foreground="#5B426F"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               FontSize="18" Margin="0,0,0,5"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="nook" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock x:Name="StatusText" Text="Я рядом ✦" Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="ExpandButton" Grid.Column="2" Content="⌄" Click="Toggle_Click"
                        Background="Transparent" Foreground="{StaticResource TextMain}"
                        BorderThickness="0" FontSize="22" Cursor="Hand" ToolTip="Открыть Nook"/>
            </Grid>
            <StackPanel x:Name="Details" Visibility="Collapsed" Margin="18,0,18,18">
                <Border Height="1" Background="#5B586C" Margin="0,0,0,13"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Устройства" Style="{StaticResource TabButton}" Click="Devices_Click"/>
                    <Button Content="Агенты" Style="{StaticResource TabButton}" Click="Agents_Click"/>
                    <Button Content="Настройки" Style="{StaticResource TabButton}" Click="Settings_Click" Margin="0"/>
                </StackPanel>
                <StackPanel x:Name="DevicesPanel">
                    <TextBlock Text="Беспроводные устройства" Foreground="{StaticResource TextMain}"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <TextBlock Text="🖱  Мышь — заряд пока недоступен" Style="{StaticResource SoftText}" Margin="0,0,0,8"/>
                    <TextBlock Text="⌨  Клавиатура — заряд пока недоступен" Style="{StaticResource SoftText}" Margin="0,0,0,8"/>
                    <TextBlock Text="🎧  Наушники — заряд пока недоступен" Style="{StaticResource SoftText}"/>
                    <TextBlock Text="Поддержку USB-приёмников добавим после проверки протоколов устройств."
                               Style="{StaticResource SoftText}" Margin="0,12,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel x:Name="AgentsPanel" Visibility="Collapsed">
                    <TextBlock Text="ИИ-агенты" Foreground="{StaticResource TextMain}"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <TextBlock Text="Codex · Claude · Gemini · Copilot" Style="{StaticResource SoftText}"/>
                    <TextBlock Text="Подключение и отображение активности ещё в разработке."
                               Style="{StaticResource SoftText}" Margin="0,11,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="Поведение Nook" Foreground="{StaticResource TextMain}"
                               FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <CheckBox x:Name="ReactionSetting" Content="Реагировать на прикосновения"
                              IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AlwaysOnTopSetting" Content="Поверх остальных окон"
                              IsChecked="True" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"
                              Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AnimationSetting" Content="Анимация дыхания"
                              IsChecked="True" Checked="Animation_Changed" Unchecked="Animation_Changed"
                              Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="Параметры пока действуют до закрытия Nook."
                               Style="{StaticResource SoftText}" Margin="0,14,0,0" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
