<Window x:Class="Nook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook" Width="340" Height="76" MinWidth="340"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="Breathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CharacterScale"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.07" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="CharacterScale"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.94" Duration="0:0:1.5"/>
        </Storyboard>
    </Window.Resources>
    <Border x:Name="Shell" CornerRadius="30" Background="#F11B1D2A"
            BorderBrush="#615A6275" BorderThickness="1"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Развернуть / свернуть" Click="Toggle_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <Grid Height="74">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="52" Height="52">
                    <Ellipse Fill="#9F8EF8" Stroke="#DACFFF" StrokeThickness="1.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="CharacterScale" CenterX="0.5" CenterY="0.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="8" Fill="#27243E" Margin="0,0,8,0"/>
                        <Ellipse Width="5" Height="8" Fill="#27243E"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nook" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock Text="Готов к работе" Foreground="#C7C5D6" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="⌄" Foreground="White" FontSize="18"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="Toggle_Click" ToolTip="Развернуть Nook"/>
            </Grid>
            <StackPanel x:Name="Details" Visibility="Collapsed" Margin="20,0,20,15">
                <Border Height="1" Background="#55515A6B" Margin="0,0,0,12"/>
                <TextBlock Text="Это первая демонстрационная версия Nook."
                           Foreground="#ECEAF8" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="Агенты и заряд устройств пока не подключены."
                           Foreground="#ABA8BD" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
