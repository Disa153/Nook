<Window x:Class="Nook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook" Width="432" Height="88" MinWidth="432"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Window.Resources>
        <LinearGradientBrush x:Key="IslandBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F31B1734" Offset="0"/>
            <GradientStop Color="#F60C0D1D" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="AvatarGradient" GradientOrigin="0.35,0.18"
                             Center="0.46,0.4" RadiusX="0.75" RadiusY="0.8">
            <GradientStop Color="#F6ECFF" Offset="0"/>
            <GradientStop Color="#C08AFF" Offset="0.44"/>
            <GradientStop Color="#7953D7" Offset="0.78"/>
            <GradientStop Color="#52349E" Offset="1"/>
        </RadialGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#393052"/>
            <Setter Property="Foreground" Value="#F4F0FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7AFCB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="#49392E56"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Storyboard x:Key="Breathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AvatarScale"
                             Storyboard.TargetProperty="ScaleX" To="1.055" Duration="0:0:1.7"/>
            <DoubleAnimation Storyboard.TargetName="AvatarScale"
                             Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:1.7"/>
        </Storyboard>
    </Window.Resources>
    <Border x:Name="IslandShell" CornerRadius="34"
            BorderThickness="1.5" BorderBrush="#CE9F72FF"
            Background="{StaticResource IslandBackground}"
            MouseLeftButtonDown="Island_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#A666FF" BlurRadius="31" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <StackPanel>
                <Grid Height="84">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Avatar" Grid.Column="0" Width="65" Height="59" Cursor="Hand"
                          MouseLeftButtonUp="Avatar_MouseLeftButtonUp"
                          MouseEnter="Avatar_MouseEnter" ToolTip="Нажми на Nook">
                        <Ellipse Fill="{StaticResource AvatarGradient}" Stroke="#DFC4FF" StrokeThickness="2">
                            <Ellipse.Effect><DropShadowEffect Color="#B061FF" BlurRadius="16" ShadowDepth="0"/></Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="AvatarScale" CenterX="0.5" CenterY="0.5"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="46" Height="34" Fill="#DE1B1238"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="EyeLeft" Fill="#FFFFFF" Width="6" Height="11" Margin="0,0,13,0"/>
                            <Ellipse x:Name="EyeRight" Fill="#FFFFFF" Width="6" Height="11"/>
                        </StackPanel>
                        <TextBlock x:Name="Smile" Text="⌣" Foreground="#F9EBFF"
                                   FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="0,0,0,9" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Nook" Foreground="#FCF9FF" FontSize="21" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="Я рядом · готов помогать"
                                   Foreground="#C5B7DD" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="MouseIndicator" Text="🖱  Проверяем…" Foreground="#E0D5F6"
                                   FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="105"/>
                        <TextBlock Text="✦  островок" Foreground="#9C8DB8" FontSize="10"
                                   HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="⌄" FontSize="23" Foreground="#F5E9FF"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Развернуть Nook" Click="Expand_Click"/>
                </Grid>
                <StackPanel x:Name="ExpandedContent" Opacity="0" Visibility="Collapsed" Margin="18,0,18,14">
                    <Border Height="1" Background="#605B5684" Margin="0,0,0,13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Устройства" Style="{StaticResource ActionButton}" Click="Devices_Click"/>
                        <Button Content="Агенты" Style="{StaticResource ActionButton}" Click="Agents_Click"/>
                        <Button Content="Настройки" Style="{StaticResource ActionButton}" Click="Settings_Click" Margin="0"/>
                    </StackPanel>
                    <StackPanel x:Name="DevicesPanel">
                        <DockPanel Margin="0,0,0,10">
                            <Button Content="↻ Обновить" DockPanel.Dock="Right" Click="Refresh_Click"
                                    Style="{StaticResource ActionButton}" Margin="0"/>
                            <TextBlock Text="Подключённые устройства" Foreground="#F9F4FF"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                        </DockPanel>
                        <Border Style="{StaticResource DeviceCard}">
                            <DockPanel>
                                <TextBlock Text="🖱" FontSize="23" DockPanel.Dock="Left" Margin="0,0,13,0"/>
                                <StackPanel>
                                    <TextBlock Text="Мышь" Foreground="#FCF9FF" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MouseName" Text="Ищем устройства Windows…"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="MouseBattery" Text="Заряд: неизвестен"
                                               Foreground="#D7AFFF" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource DeviceCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" FontSize="22" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Клавиатура" Foreground="#FCF9FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Определение модели — следующий этап"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DeviceCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎧" FontSize="22" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Наушники" Foreground="#FCF9FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Заряд по USB-приёмнику пока недоступен"
                                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DetectionHint" Style="{StaticResource Caption}"
                                   Text="Проверяем подключённые мыши через Windows. Это не измерение батареи."
                                   FontSize="11" Margin="1,4,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AgentsPanel" Visibility="Collapsed">
                        <TextBlock Text="Агенты" Foreground="#FCF9FF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource DeviceCard}">
                            <TextBlock Text="✦  Codex     ·     Claude     ·     Gemini     ·     Copilot"
                                       Style="{StaticResource Caption}" />
                        </Border>
                        <TextBlock Text="Это макет раздела. Авторизация и работа агентов ещё не подключены."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="Настройки персонажа" Foreground="#FCF9FF" FontWeight="SemiBold"
                                   FontSize="16" Margin="0,0,0,15"/>
                        <CheckBox x:Name="ReactionSetting" IsChecked="True" Content="Реагировать на нажатия"
                                  Foreground="#EEE6FA" Margin="0,0,0,12"/>
                        <CheckBox x:Name="AnimationSetting" IsChecked="True" Content="Плавная анимация"
                                  Foreground="#EEE6FA" Checked="AnimationSetting_Changed"
                                  Unchecked="AnimationSetting_Changed" Margin="0,0,0,12"/>
                        <CheckBox x:Name="TopmostSetting" IsChecked="True" Content="Поверх остальных окон"
                                  Foreground="#EEE6FA" Checked="TopmostSetting_Changed"
                                  Unchecked="TopmostSetting_Changed" Margin="0,0,0,12"/>
                        <TextBlock Text="Настройки пока сохраняются только до закрытия приложения."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>